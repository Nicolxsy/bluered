FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PEER_BIND_HOST=0.0.0.0 \
    UI_HOST=0.0.0.0 \
    SHARED_DIR=/data/shared \
    DOWNLOAD_DIR=/data/downloads \
    DB_PATH=/data/db/peer.db \
    AUTO_LOGIN=1

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY shared/ ./shared/
COPY client/ ./client/
COPY server/pyproject.toml ./server/pyproject.toml

RUN uv sync --no-dev --package bluered-client \
    && mkdir -p /data/shared /data/downloads /data/db

EXPOSE 8001 2234

CMD ["uv", "run", "--no-sync", "python", "-m", "bluered_client.main"]
