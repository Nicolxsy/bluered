FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    SERVER_HOST=0.0.0.0 \
    SERVER_PORT=8000

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY shared/ ./shared/
COPY server/ ./server/
COPY client/pyproject.toml ./client/pyproject.toml
COPY docker/run_server.py ./docker/run_server.py

RUN uv sync --no-dev --package bluered-server

EXPOSE 8000

CMD ["uv", "run", "--no-sync", "python", "/app/docker/run_server.py"]
